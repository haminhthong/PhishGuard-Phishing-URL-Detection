# Cấu hình runtime local; không lưu bí mật thật trong repository.
PHISHGUARD_HOST=127.0.0.1
PHISHGUARD_PORT=5000
PHISHGUARD_RELOAD=false
PHISHGUARD_MAX_URL_LENGTH=2048
PHISHGUARD_MAX_BATCH_SIZE=50
PHISHGUARD_TIMEOUT=3.5
PHISHGUARD_LOG_LEVEL=INFO

# Bỏ trống để loader dùng artifacts/.
# PHISHGUARD_MODEL_PATH=artifacts/model.json
# PHISHGUARD_METADATA_PATH=artifacts/metadata.json
