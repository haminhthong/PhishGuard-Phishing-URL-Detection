# Cấu hình runtime; không lưu bí mật thật trong repository.
PHISHGUARD_HOST=127.0.0.1
PHISHGUARD_PORT=5000
PHISHGUARD_RELOAD=false
PHISHGUARD_CACHE_SIZE=1024
# Mặc định loader đọc releases/current_release.json.
# Chỉ dùng hai biến dưới đây khi chạy kiểm thử một bundle cụ thể.
# PHISHGUARD_MODEL_PATH=releases/candidates/phishguard-4.0.0/model.json
# PHISHGUARD_METADATA_PATH=releases/candidates/phishguard-4.0.0/metadata.json
